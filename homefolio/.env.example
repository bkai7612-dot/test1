# Copy to .env.local for local development. Production values are set in
# Vercel (web app) and GitHub (Windows/iPhone/Android builds): see LAUNCH.md.
# The anon/publishable key is designed for browsers; data is protected by
# Row Level Security. Never put the service_role / secret key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where email links (confirm sign-up, reset password) send people.
VITE_SITE_URL=http://localhost:5173
# The marketing website (terms, privacy, support links).
VITE_WEBSITE_URL=https://homefolio.co.uk
VITE_SUPPORT_EMAIL=support@homefolio.co.uk

# RevenueCat public API keys for Homefolio Plus (leave empty to disable purchases).
VITE_REVENUECAT_WEB_KEY=
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
