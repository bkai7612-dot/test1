{
  "name": "Voidline",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Maps": {
        "$className": "Folder"
      },
      "Objectives": {
        "$className": "Folder"
      },
      "ServerAssets": {
        "$className": "Folder"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 6,
        "CharacterWalkSpeed": 14,
        "CameraMaxZoomDistance": 24
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "Lobby": {
        "$className": "Folder"
      },
      "ActiveMap": {
        "$className": "Folder"
      },
      "SpawnPoints": {
        "$className": "Folder"
      },
      "InteractiveObjects": {
        "$className": "Folder"
      }
    }
  }
}
