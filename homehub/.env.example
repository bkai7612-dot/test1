# Copy to .env.local and fill in from your Supabase project (Settings → API).
# The anon/publishable key is designed to be used in the browser; data is
# protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
